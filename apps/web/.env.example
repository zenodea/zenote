# Copy to .env.local, then `npm run db:start`.
#
# These are the standard local Supabase demo keys — identical on every machine
# and not secret. Production values live in the Vercel project settings.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Used ONLY by scripts/seed.ts. Never referenced from app code, never NEXT_PUBLIC_*.
# `supabase status` prints this after the stack is up.
SUPABASE_SERVICE_ROLE_KEY=
