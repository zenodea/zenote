{
  "name": "zenote-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop shell for Zenote",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "app.zenote.desktop",
    "productName": "Zenote",
    "files": [
      "main.js"
    ],
    "linux": {
      "target": "AppImage"
    },
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    }
  },
  "allowScripts": {
    "electron@38.8.6": true
  }
}
